# ── Backend ──────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# Public URL the backend is reachable at. The Remotion render process fetches
# uploaded clips over http from here (Remotion rejects file:// paths).
PUBLIC_BASE_URL=http://localhost:3001

# Storage: "local" | "s3" | "r2"
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./uploads

# S3 / Cloudflare R2 (used when STORAGE_PROVIDER=s3 or r2)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=          # R2 only

# Background removal: "mock" | "replicate" | "runway" | "unscreen"
BG_REMOVAL_PROVIDER=mock
# Replicate (arielreplicate/robust_video_matting). Get a token at
# https://replicate.com/account/api-tokens. NOTE: the model fetches the input
# clip from PUBLIC_BASE_URL, so that URL must be reachable by Replicate — in
# local dev expose the backend with a tunnel (e.g. ngrok) and set PUBLIC_BASE_URL.
REPLICATE_API_TOKEN=
RUNWAY_API_KEY=
UNSCREEN_API_KEY=

# Queue: "memory" | "bullmq"
QUEUE_PROVIDER=memory
REDIS_URL=            # BullMQ only

# Remotion render output dir (local)
RENDER_OUTPUT_DIR=./renders

# ── Payments (stub in v1) ─────────────────────────────────
# Provider: "stub" | "payfast" | "stripe"
PAYMENT_PROVIDER=stub
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Frontend (Vite) ───────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3001
